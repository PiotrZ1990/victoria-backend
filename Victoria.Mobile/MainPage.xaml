<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Victoria.Mobile.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Victoria Mobile"
               FontSize="28"
               FontAttributes="Bold" />

        <Button Text="Test API (Swagger JSON)"
                Clicked="OnTestApiClicked" />

        <Label x:Name="ResultLabel"
               Text="Kliknij przycisk, żeby sprawdzić API..."
               FontSize="14" />
    </VerticalStackLayout>
</ContentPage>
