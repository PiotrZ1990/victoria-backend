<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="Victoria.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Victoria.Mobile.Pages"
    FlyoutBehavior="Disabled">

    <!-- PUBLIC (no login) -->
    <TabBar Route="public">
        <ShellContent Route="home" Title="Home" ContentTemplate="{DataTemplate pages:PublicHomePage}" />
        <ShellContent Route="courses" Title="Courses" ContentTemplate="{DataTemplate pages:CoursesPage}" />
        <ShellContent Route="news" Title="News" ContentTemplate="{DataTemplate pages:NewsPage}" />
        <ShellContent Route="apply" Title="Apply" ContentTemplate="{DataTemplate pages:ApplyPage}" />
    </TabBar>

    <!-- LOGIN -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate pages:LoginPage}" />

    <!-- APP (logged in) -->
    <FlyoutItem x:Name="AppFlyout"
                Route="app"
                Title="Victoria"
                FlyoutDisplayOptions="AsSingleItem"
                IsVisible="False">

        <ShellContent Route="home" Title="Home" ContentTemplate="{DataTemplate pages:MainPage}" />
        <ShellContent Route="mycases" Title="My Cases" ContentTemplate="{DataTemplate pages:MyCasesPage}" />
    </FlyoutItem>
</Shell>
