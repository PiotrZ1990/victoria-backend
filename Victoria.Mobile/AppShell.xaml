<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="Victoria.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Victoria.Mobile.Pages">

    <!-- LOGIN jako start -->
    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate pages:LoginPage}" />

    <!-- Główna część aplikacji (po zalogowaniu) -->
    <FlyoutItem Title="Home" Route="main">
        <ShellContent
            Title="Home"
            Route="home"
            ContentTemplate="{DataTemplate pages:MainPage}" />

        <ShellContent
            Title="My Cases"
            Route="cases"
            ContentTemplate="{DataTemplate pages:MyCasesPage}" />
    </FlyoutItem>

</Shell>
