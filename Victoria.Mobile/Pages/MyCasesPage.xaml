<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Victoria.Mobile.Pages.MyCasesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="My Cases">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="My Cases" FontSize="24" FontAttributes="Bold" />

        <Button Text="Refresh" Clicked="OnRefreshClicked" />

        <CollectionView x:Name="CasesList"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding ClientName}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Stage}" FontSize="14" />
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="Status:" FontAttributes="Bold" />
                                <Label Text="{Binding Status}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd HH:mm}'}"
                                   FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding Id, StringFormat='Case ID: {0}'}"
                                   FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="ErrorLabel" TextColor="Red" />

    </VerticalStackLayout>
</ContentPage>
