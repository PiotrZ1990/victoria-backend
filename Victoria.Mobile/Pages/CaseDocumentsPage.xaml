<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Victoria.Mobile.Pages.CaseDocumentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Documents">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Documents" FontSize="24" FontAttributes="Bold" />

        <ActivityIndicator x:Name="Loader" IsVisible="False" IsRunning="False" />
        <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
            <!--<VerticalStackLayout Spacing="10">
                --><!--<Label Text="Add document" FontAttributes="Bold" />

                <Entry x:Name="TitleEntry" Placeholder="Title (e.g. Passport)" />
                <Entry x:Name="DescEntry" Placeholder="Description (optional)" />

                <HorizontalStackLayout Spacing="10">
                    <Button Text="Pick file" Clicked="OnPickFileClicked" />
                    <Label x:Name="PickedFileLabel" Text="No file selected" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Button Text="Upload" Clicked="OnUploadClicked" />--><!--
            </VerticalStackLayout>-->
        </Frame>
        <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
            <VerticalStackLayout Spacing="10">
                <Label Text="Required documents (checklist) - PLEASE SEND REQUIRED DOCUMENTS TO YOUR SUPERVISOR VIA MAIL/POST" FontAttributes="Bold" />

                <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
                    <VerticalStackLayout Spacing="10">

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Checklist" FontAttributes="Bold" FontSize="16" />
                            <Label x:Name="ChecklistSummaryLabel"
                   Text="(loading...)"
                   TextColor="Gray"
                   FontSize="12"
                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Button x:Name="ToggleChecklistBtn"
                Text="Show checklist"
                Clicked="OnToggleChecklistClicked" />

                        <VerticalStackLayout x:Name="ChecklistPanel" IsVisible="False" Spacing="8">

                            <ScrollView HeightRequest="260">
                                <CollectionView x:Name="ChecklistList" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame BorderColor="#eee" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{Binding DocumentType}" FontAttributes="Bold" />

                                                    <HorizontalStackLayout Spacing="10">
                                                        <Label Text="{Binding Flow}" FontSize="12" TextColor="Gray"/>
                                                        <Label Text="{Binding IsRequired, StringFormat='Required: {0}'}" FontSize="12" TextColor="Gray"/>
                                                    </HorizontalStackLayout>

                                                    <Label Text="{Binding IsCompleted, StringFormat='Completed: {0}'}" />
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </ScrollView>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </Frame>

        <CollectionView x:Name="DocsList"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Status}" />
                            <Label Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd HH:mm}'}"
                                   FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding File.FileName, StringFormat='File: {0}'}" FontSize="12" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="ErrorLabel" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>
