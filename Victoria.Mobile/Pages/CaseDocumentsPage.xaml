<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Victoria.Mobile.Pages.CaseDocumentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Documents">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Documents" FontSize="24" FontAttributes="Bold" />

        <ActivityIndicator x:Name="Loader" IsVisible="False" IsRunning="False" />
        <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
            <VerticalStackLayout Spacing="10">
                <Label Text="Add document" FontAttributes="Bold" />

                <Entry x:Name="TitleEntry" Placeholder="Title (e.g. Passport)" />
                <Entry x:Name="DescEntry" Placeholder="Description (optional)" />

                <HorizontalStackLayout Spacing="10">
                    <Button Text="Pick file" Clicked="OnPickFileClicked" />
                    <Label x:Name="PickedFileLabel" Text="No file selected" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Button Text="Upload" Clicked="OnUploadClicked" />
            </VerticalStackLayout>
        </Frame>
        <CollectionView x:Name="DocsList"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Status}" />
                            <Label Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd HH:mm}'}"
                                   FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding File.FileName, StringFormat='File: {0}'}" FontSize="12" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="ErrorLabel" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>
