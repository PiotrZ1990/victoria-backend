<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Victoria.Mobile.Pages.CaseDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Case Details">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Case Details" FontSize="24" FontAttributes="Bold" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding Error}" TextColor="Red" />

            <Frame BorderColor="#ddd" CornerRadius="12" Padding="12" IsVisible="{Binding Item, Converter={StaticResource NullToBoolConverter}}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Item.ClientName}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding Item.Stage, StringFormat='Stage: {0}'}" />
                    <Label Text="{Binding Item.Status, StringFormat='Status: {0}'}" />
                    <Label Text="{Binding Item.CreatedAt, StringFormat='Created: {0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding Item.Id, StringFormat='Case ID: {0}'}" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Back" Clicked="OnBackClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
