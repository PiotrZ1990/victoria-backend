<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Victoria.Mobile.Pages.CaseDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Case Details">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Case Details" FontSize="24" FontAttributes="Bold" />

            <ActivityIndicator x:Name="Loader" IsRunning="True" IsVisible="True" />

            <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="ClientNameLabel" FontAttributes="Bold" FontSize="18" />
                    <Label x:Name="StageLabel" />
                    <Label x:Name="StatusLabel" />

                    <Label x:Name="CreatedAtLabel" FontSize="12" TextColor="Gray" />
                    <Label x:Name="CaseIdLabel" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Next actions" FontAttributes="Bold" />
                    <Button Text="Documents (next)" IsEnabled="False" />
                    <Button Text="Invoices (next)" IsEnabled="False" />
                </VerticalStackLayout>
            </Frame>

            <Label x:Name="ErrorLabel" TextColor="Red" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
