<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Victoria.Mobile.Pages.CaseInvoicesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Invoices">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Invoices" FontSize="22" FontAttributes="Bold" />

        <ActivityIndicator x:Name="Loader" IsVisible="False" IsRunning="False" />

        <CollectionView x:Name="InvoicesList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding InvoiceNumber}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding IssueDate, StringFormat='Issue: {0:yyyy-MM-dd}'}" />
                            <Label Text="{Binding TotalAmount, StringFormat='Total: {0}'}" />
                            <Label Text="{Binding Currency, StringFormat='Currency: {0}'}" FontSize="12" TextColor="Gray"/>
                            <Label Text="{Binding Status, StringFormat='Status: {0}'}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="ErrorLabel" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>
