<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Victoria.Mobile.Pages.MyEnrollmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="My Enrollments">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="My Enrollments" FontSize="24" FontAttributes="Bold" />

        <Button Text="Refresh" Clicked="OnRefreshClicked" />

        <CollectionView x:Name="EnrollmentsList" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding CourseName}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding GroupName, StringFormat='Group: {0}'}" />
                            <Label Text="{Binding Location, StringFormat='Location: {0}'}" />
                            <Label Text="{Binding StartDate, StringFormat='Start: {0:yyyy-MM-dd}'}" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding EndDate, StringFormat='End: {0:yyyy-MM-dd}'}" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding CreatedAt, StringFormat='Enrolled: {0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="ErrorLabel" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>
