<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Victoria.Mobile.Pages.NewsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="News">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="News" FontSize="24" FontAttributes="Bold" />

        <Button Text="Refresh" Clicked="OnRefreshClicked" />

        <ActivityIndicator x:Name="Loader" IsRunning="False" IsVisible="False" />

        <CollectionView x:Name="NewsList"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#ddd" CornerRadius="12" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Summary}" FontSize="13" TextColor="Gray" />
                            <Label Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd}'}"
                                   FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="ErrorLabel" TextColor="Red" />

    </VerticalStackLayout>
</ContentPage>
