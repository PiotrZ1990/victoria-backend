@{
    ViewBag.Title = "Login";
}

<h2>Logowanie</h2>

<form method="post">
    <div>
        <label>Email</label>
        <input name="email" />
    </div>

    <div>
        <label>Hasło</label>
        <input name="password" type="password" />
    </div>

    <button type="submit">Zaloguj</button>
</form>

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}
