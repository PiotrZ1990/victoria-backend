@model List<Victoria.Web.Models.Education.StudentListViewModel>
@{
    ViewData["Title"] = "Students";
}

<h2 class="mb-3">Students</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-success" href="/Students/Create">+ Create</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Full name</th>
            <th>Email</th>
            <th>Active</th>
            <th>Created</th>
            <th style="width:140px;"></th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="6" class="text-center">No students.</td></tr>
        }
        else
        {
            foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.FullName</td>
                    <td>@(s.Email ?? "-")</td>
                    <td>@(s.IsActive ? "Yes" : "No")</td>
                    <td>@s.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/Students/Details/@s.Id">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
