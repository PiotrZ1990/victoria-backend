@model Victoria.Web.Models.Visa.VisaApplicationCreateViewModel
@{
    ViewData["Title"] = "Create Visa Application";
}

<h2 class="mb-3">Create Visa Application</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="CaseFileId" />

    <div class="mb-3">
        <label class="form-label">Country</label>
        <input class="form-control" asp-for="Country" />
    </div>

    <div class="mb-3">
        <label class="form-label">Visa Type</label>
        <input class="form-control" asp-for="VisaType" />
        <small class="text-muted">np. Student, Tourist, Work</small>
    </div>

    <div class="mb-3">
        <label class="form-label">Status</label>
        <input class="form-control" asp-for="Status" />
        <small class="text-muted">np. Draft, Submitted, Approved, Rejected</small>
    </div>

    <div class="mb-3">
        <label class="form-label">Appointment Date</label>
        <input class="form-control" asp-for="AppointmentDate" type="date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Decision Date</label>
        <input class="form-control" asp-for="DecisionDate" type="date" />
    </div>

    <button class="btn btn-success" type="submit">Create</button>
    <a class="btn btn-secondary" href="/VisaApplications?caseFileId=@Model.CaseFileId">Cancel</a>
</form>
