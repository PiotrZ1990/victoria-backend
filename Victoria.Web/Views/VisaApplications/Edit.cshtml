@model Victoria.Web.Models.Visa.VisaApplicationEditViewModel
@{
    ViewData["Title"] = "Edit Visa Application";
    var caseFileId = (int)ViewBag.CaseFileId;
}

<h2 class="mb-3">Edit Visa Application</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="caseFileId" value="@caseFileId" />

    <div class="mb-3">
        <label class="form-label">Country</label>
        <input class="form-control" asp-for="Country" />
    </div>

    <div class="mb-3">
        <label class="form-label">Visa Type</label>
        <input class="form-control" asp-for="VisaType" />
    </div>

    <div class="mb-3">
        <label class="form-label">Status</label>
        <input class="form-control" asp-for="Status" />
    </div>

    <div class="mb-3">
        <label class="form-label">Appointment Date</label>
        <input class="form-control" asp-for="AppointmentDate" type="date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Decision Date</label>
        <input class="form-control" asp-for="DecisionDate" type="date" />
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/VisaApplications/Details/@Model.Id">Cancel</a>
</form>
