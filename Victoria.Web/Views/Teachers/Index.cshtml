@model List<Victoria.Web.Models.Cms.TeacherListViewModel>
@{
    ViewData["Title"] = "Teachers";
}

<h2 class="mb-3">Teachers</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" href="/Teachers/Create">+ Create</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Title</th>
            <th>Active</th>
            <th>Created</th>
            <th style="width:240px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="6" class="text-center">No teachers.</td></tr>
        }
        else
        {
            foreach (var t in Model)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.FullName</td>
                    <td>@(t.Title ?? "-")</td>
                    <td>@(t.IsActive ? "Yes" : "No")</td>
                    <td>@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a class="btn btn-sm btn-info" href="/Teachers/Details/@t.Id">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
