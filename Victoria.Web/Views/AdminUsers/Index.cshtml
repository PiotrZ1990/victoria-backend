@model List<Victoria.Web.Models.Admin.AdminUserListVm>
@{
    ViewData["Title"] = "Users & Roles";
}

<h2 class="mb-3">Users & Roles</h2>
@{
    var sort = (ViewBag.Sort as string) ?? "created_desc";
}

<form method="get" class="mb-3" style="max-width:320px;">
    <label class="form-label">Sort</label>
    <select class="form-select" name="sort" onchange="this.form.submit()">
        <option value="created_desc" selected="@(sort == "created_desc")">Created: newest</option>
        <option value="created_asc" selected="@(sort == "created_asc")">Created: oldest</option>

    </select>
</form>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Full name</th>
            <th>StudentId</th>
            <th>Roles</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.FullName</td>
                <td>@(u.StudentId?.ToString() ?? "-")</td>
                <td>@(u.Roles.Count == 0 ? "-" : string.Join(", ", u.Roles))</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" href="/AdminUsers/Edit/@u.Id">Edit roles</a>
                </td>
            </tr>
        }
    </tbody>
</table>
