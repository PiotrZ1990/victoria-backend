@model Victoria.Web.Models.Admin.AdminUserEditVm
@{
    ViewData["Title"] = "Edit roles";
}

<h2 class="mb-3">Edit roles</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div><strong>Email:</strong> @Model.Email</div>
        <div><strong>Full name:</strong> @Model.FullName</div>
        <div><strong>StudentId:</strong> @(Model.StudentId?.ToString() ?? "-")</div>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="Email" value="@Model.Email" />
    <input type="hidden" name="FullName" value="@Model.FullName" />
    <input type="hidden" name="StudentId" value="@Model.StudentId" />

    <div class="card">
        <div class="card-header"><strong>Roles</strong></div>
        <div class="card-body">
            @if (Model.AllRoles == null || Model.AllRoles.Count == 0)
            {
                <div class="text-muted">No roles in system yet. Assign any role - it will be created.</div>
            }

            <div class="row">
                @{
                    var roles = (Model.AllRoles ?? new List<string>()).Distinct().ToList();
                    // dodajemy typowe role nawet jeśli pusto
                    foreach (var must in new[] { "Admin", "Staff", "Client" })
                        if (!roles.Contains(must)) roles.Add(must);

                    roles = roles.OrderBy(x => x).ToList();
                }

                @foreach (var r in roles)
                {
                    var isChecked = Model.SelectedRoles != null && Model.SelectedRoles.Contains(r);
                    <div class="col-12 col-md-4 mb-2">
                        <label class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedRoles"
                                   value="@r"
                                   @(isChecked ? "checked" : "") />
                            <span class="form-check-label">@r</span>
                        </label>
                    </div>
                }
            </div>

            <div class="mt-3">
                <button class="btn btn-success" type="submit">Save</button>
                <a class="btn btn-secondary" href="/AdminUsers">Back</a>
            </div>
        </div>
    </div>
</form>
