@model Victoria.Web.Models.Education.ExamCreateViewModel
@{
    ViewData["Title"] = "Create Exam";
}

<h2 class="mb-3">Create Exam</h2>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" name="Name" value="@Model?.Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">ExamType (enum)</label>
        <input class="form-control" name="ExamType" value="@Model?.ExamType" />
        <small class="text-muted">np. IELTS, TOEFL, PTE (musi pasować do enum ExamType)</small>
        <span class="text-danger" asp-validation-for="ExamType"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="Description" rows="5">@Model?.Description</textarea>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
        <label class="form-check-label">Active</label>
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/Exams">Cancel</a>
</form>
