@model List<Victoria.Web.Models.Payments.PaymentViewModel>

<h2 class="mb-3">Payments</h2>

@if (Model == null || !Model.Any())
{
    <p>No payments.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>CaseFileId</th>
                <th>Amount</th>
                <th>Currency</th>
                <th>Method</th>
                <th>Service</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.CaseFileId</td>
                    <td>@p.Amount</td>
                    <td>@p.Currency</td>
                    <td>@p.PaymentMethod</td>
                    <td>@p.ServiceType</td>
                    <td>@p.Status</td>
                    <td>@p.PaymentDate.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
