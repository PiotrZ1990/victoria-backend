@model List<Victoria.Web.Models.Cms.PageSectionListViewModel>
@{
    ViewData["Title"] = "Page Sections";
    var pageId = (int)ViewBag.PageId;
}

<h2 class="mb-3">Page Sections</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" href="/PageSections/Create?pageId=@pageId">+ Add section</a>
    <a class="btn btn-secondary ms-2" href="/Pages/Details/@pageId">← Back to Page</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Order</th>
            <th>Key</th>
            <th>Title</th>
            <th>Updated</th>
            <th style="width:140px;"></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center">No sections.</td></tr>
        }
        else
        {
            foreach (var x in Model)
            {
                <tr>
                    <td>@x.Order</td>
                    <td>@x.SectionKey</td>
                    <td>@(x.Title ?? "-")</td>
                    <td>@x.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/PageSections/Details/@x.Id">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
