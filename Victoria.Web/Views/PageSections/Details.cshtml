@model Victoria.Web.Models.Cms.PageSectionDetailsViewModel
@{
    ViewData["Title"] = "Section Details";
}

<h2 class="mb-3">Section Details</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>PageId:</strong> @Model.PageId</p>
        <p><strong>Order:</strong> @Model.Order</p>
        <p><strong>Key:</strong> @Model.SectionKey</p>
        <p><strong>Title:</strong> @(Model.Title ?? "-")</p>
        <p><strong>Updated:</strong> @Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</p>

        <hr />
        <h5>Content</h5>
        <div class="border rounded p-2" style="white-space:pre-wrap;">@(Model.Content ?? "")</div>

        <hr />
        <a class="btn btn-secondary" href="/PageSections?pageId=@Model.PageId">← Back</a>
        <a class="btn btn-warning ms-2" href="/PageSections/Edit/@Model.Id">Edit</a>

        <form method="post" action="/PageSections/Delete/@Model.Id" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="pageId" value="@Model.PageId" />
            <button class="btn btn-danger ms-2" onclick="return confirm('Delete section?');">Delete</button>
        </form>
    </div>
</div>
