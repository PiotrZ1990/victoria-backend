@model Victoria.Web.Models.Applications.StudyApplicationEditViewModel

@{
    ViewData["Title"] = "Edit Study Application";
}

<h2 class="mb-3">Edit Study Application</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CaseFileId" />

    <div class="mb-3">
        <label class="form-label">Country</label>
        <input class="form-control" asp-for="Country" />
    </div>

    <div class="mb-3">
        <label class="form-label">University name</label>
        <input class="form-control" asp-for="UniversityName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Program name</label>
        <input class="form-control" asp-for="ProgramName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Status</label>
        <select class="form-select" asp-for="Status">
            <option>Draft</option>
            <option>Submitted</option>
            <option>Approved</option>
            <option>Rejected</option>
        </select>
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/StudyApplications?caseFileId=@Model.CaseFileId">Cancel</a>
</form>
