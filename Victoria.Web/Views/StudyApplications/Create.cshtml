@model Victoria.Web.Models.Applications.StudyApplicationCreateViewModel
@{
    ViewData["Title"] = "Create Study Application";
}

<h2 class="mb-3">Create Study Application</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="CaseFileId" />

    <div class="mb-3">
        <label class="form-label">Country</label>
        <input class="form-control" asp-for="Country" />
        <span class="text-danger" asp-validation-for="Country"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">University</label>
        <input class="form-control" asp-for="UniversityName" />
        <span class="text-danger" asp-validation-for="UniversityName"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Program</label>
        <input class="form-control" asp-for="ProgramName" />
        <span class="text-danger" asp-validation-for="ProgramName"></span>
    </div>

    <button class="btn btn-success" type="submit">Create</button>
    <a class="btn btn-secondary" href="/StudyApplications?caseFileId=@Model.CaseFileId">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
