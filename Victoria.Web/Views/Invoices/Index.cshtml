@model List<Victoria.Web.Models.Payments.InvoiceListViewModel>

<h2>Invoices</h2>

<a class="btn btn-outline-success mb-3" href="/Reports/OutstandingInvoicesExcel">Export Outstanding (Excel)</a>
<a class="btn btn-outline-danger mb-3" href="/Reports/OutstandingInvoicesPdf">Export Outstanding (PDF)</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<h2 class="mb-3">Leads (CRM)</h2>
@{
    var sort = (ViewBag.Sort as string) ?? "created_desc";
}

<form method="get" class="mb-3" style="max-width:320px;">
    <label class="form-label">Sort</label>
    <select class="form-select" name="sort" onchange="this.form.submit()">
        <option value="created_desc" selected="@(sort == "created_desc")">Created: newest</option>
        <option value="created_asc" selected="@(sort == "created_asc")">Created: oldest</option>

        <option value="id_desc" selected="@(sort == "id_desc")">ID: desc</option>
        <option value="id_asc" selected="@(sort == "id_asc")">ID: asc</option>

        <option value="name_asc" selected="@(sort == "name_asc")">Name: A-Z</option>
        <option value="name_desc" selected="@(sort == "name_desc")">Name: Z-A</option>

        <option value="status_asc" selected="@(sort == "status_asc")">Status: A-Z</option>
        <option value="status_desc" selected="@(sort == "status_desc")">Status: Z-A</option>
    </select>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Issue date</th>
            <th>Total</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.InvoiceNumber</td>
                <td>@i.IssueDate.ToString("yyyy-MM-dd")</td>
                <td>@i.TotalAmount @i.Currency</td>
                <td>@i.Status</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/Invoices/Details/@i.Id">Details</a>
                    <a class="btn btn-sm btn-secondary" href="/Invoices/Edit/@i.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
