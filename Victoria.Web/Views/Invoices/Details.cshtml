@model Victoria.Web.Models.Payments.InvoiceDetailsViewModel
@using Victoria.Web.Models.Payments

@{
    ViewData["Title"] = "Invoice Details";
    var paymentCreate = (PaymentCreateViewModel)ViewBag.PaymentCreate;
}

<h2 class="mb-3">Invoice Details</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">
    <div class="card-header"><strong>Invoice</strong></div>
    <div class="card-body">
        <p><strong>Invoice #:</strong> @Model.InvoiceNumber</p>
        <p>
            <strong>Status:</strong>
            @{
                var badge = "bg-secondary";
                if (Model.Status == "Paid") badge = "bg-success";
                else if (Model.Status == "PartiallyPaid") badge = "bg-warning";
                else if (Model.Status == "Overdue") badge = "bg-danger";
            }
            <span class="badge @badge">@Model.Status</span>
        </p>

        <p><strong>Issue date:</strong> @Model.IssueDate.ToString("yyyy-MM-dd")</p>
        <p><strong>Total:</strong> @Model.TotalAmount @Model.Currency</p>
        <p><strong>Paid:</strong> @Model.PaidAmount @Model.Currency</p>
        <p><strong>Remaining:</strong> @Model.RemainingAmount @Model.Currency</p>

        <a class="btn btn-outline-dark ms-2"
           href="/Printouts/InvoiceDocx?invoiceId=@Model.Id">
            Download DOCX (template)
        </a>


        <a class="btn btn-secondary"
           href="/CaseFiles/Details/@Model.CaseFileId">
            ← Back to Case
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><strong>Payments</strong></div>
    <div class="card-body">
        @if (Model.Payments == null || !Model.Payments.Any())
        {
            <p>No payments for this invoice.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Service</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td>@p.PaymentDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@p.Amount @p.Currency</td>
                            <td>@p.PaymentMethod</td>
                            <td>@p.ServiceType</td>
                            <td>@p.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card">
    <div class="card-header"><strong>Add Payment</strong></div>
    <div class="card-body">
        <form asp-action="AddPayment" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="InvoiceId" value="@paymentCreate.InvoiceId" />
            <input type="hidden" name="CaseFileId" value="@paymentCreate.CaseFileId" />

            <div class="mb-3">
                <label class="form-label">Amount</label>
                <input class="form-control"
                       name="Amount"
                       type="number"
                       step="0.01"
                       min="0.01"
                       max="@Model.RemainingAmount"
                       value="0.01" />
                <small class="text-muted">Max: @Model.RemainingAmount @Model.Currency</small>
            </div>

            <div class="mb-3">
                <label class="form-label">Currency</label>
                <input class="form-control" name="Currency" value="@paymentCreate.Currency" />
            </div>

            <div class="mb-3">
                <label class="form-label">Payment Method</label>
                <select class="form-select" name="PaymentMethod">
                    <option>BankTransfer</option>
                    <option>Card</option>
                    <option>Cash</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Service Type</label>
                <select class="form-select" name="ServiceType">
                    <option>Application</option>
                    <option>Visa</option>
                    <option>Accommodation</option>
                </select>
            </div>

            <button class="btn btn-success" type="submit">
                Add payment
            </button>
        </form>
    </div>
</div>
