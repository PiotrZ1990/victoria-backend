@model Victoria.Web.Models.Payments.InvoiceEditViewModel
<h2>Edit invoice</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Invoice number</label>
        <input class="form-control" asp-for="InvoiceNumber" />
    </div>

    <div class="mb-3">
        <label class="form-label">Issue date</label>
        <input class="form-control" asp-for="IssueDate" type="date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Total amount</label>
        <input class="form-control" asp-for="TotalAmount" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label class="form-label">Currency</label>
        <input class="form-control" asp-for="Currency" />
    </div>

    <div class="mb-3">
        <label class="form-label">Status</label>
        <select class="form-select" asp-for="Status">
            <option>Issued</option>
            <option>PartiallyPaid</option>
            <option>Paid</option>
            <option>Overdue</option>
            <option>Cancelled</option>
        </select>
    </div>

    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" href="/Invoices/Details/@Model.Id">Cancel</a>
</form>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button class="btn btn-danger" type="submit">Delete</button>
</form>
