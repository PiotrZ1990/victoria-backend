@model List<Victoria.Web.Models.Cms.TestimonialListViewModel>

@{
    ViewData["Title"] = "Testimonials";
}

<h2 class="mb-3">Testimonials</h2>
@{
    var sort = (ViewBag.Sort as string) ?? "created_desc";
}

<form method="get" class="mb-3" style="max-width:320px;">
    <label class="form-label">Sort</label>
    <select class="form-select" name="sort" onchange="this.form.submit()">
        <option value="created_desc" selected="@(sort == "created_desc")">Created: newest</option>
        <option value="created_asc" selected="@(sort == "created_asc")">Created: oldest</option>

    </select>
</form>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" href="/Testimonials/Create">+ Create</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Author</th>
            <th>Country</th>
            <th>Rating</th>
            <th>Published</th>
            <th>Created</th>
            <th style="width:240px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="6" class="text-center">No testimonials.</td></tr>
        }
        else
        {
            foreach (var t in Model)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.AuthorName</td>
                    <td>@t.Country</td>
                    <td>@t.Rating</td>
                    <td>@(t.IsPublished ? "Yes" : "No")</td>
                    <td>@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a class="btn btn-sm btn-info" href="/Testimonials/Details/@t.Id">Details</a>    
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
