@model Victoria.Web.Models.Cms.PageDetailsViewModel
@{
    ViewData["Title"] = "Page Details";
}

<h2 class="mb-3">Page Details</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>Title:</strong> @Model.Title</p>
        <p><strong>Slug:</strong> @Model.Slug</p>
        <p><strong>Published:</strong> @(Model.IsPublished ? "Yes" : "No")</p>
        <p><strong>Created:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
        <p><strong>Updated:</strong> @(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</p>

        <hr />
        <a class="btn btn-secondary" href="/Pages">← Back</a>
        <a class="btn btn-warning ms-2" href="/Pages/Edit/@Model.Id">Edit</a>

        <form method="post" action="/Pages/Delete/@Model.Id" style="display:inline;">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger ms-2" onclick="return confirm('Delete page?');">Delete</button>
        </form>
    </div>
</div>

<a class="btn btn-outline-primary"
   href="/PageSections?pageId=@Model.Id">
    Manage sections
</a>
