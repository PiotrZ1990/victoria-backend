@model Victoria.Web.Models.Education.LanguageCourseCreateViewModel
@{
    ViewData["Title"] = "Create Language Course";
}

<h2 class="mb-3">Create Language Course</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Language</label>
            <input class="form-control" asp-for="Language" />
            <span class="text-danger" asp-validation-for="Language"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Level</label>
            <input class="form-control" asp-for="Level" />
            <span class="text-danger" asp-validation-for="Level"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label class="form-label">Price</label>
            <input class="form-control" asp-for="Price" />
            <span class="text-danger" asp-validation-for="Price"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label class="form-label">Currency</label>
            <input class="form-control" asp-for="Currency" />
            <span class="text-danger" asp-validation-for="Currency"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" asp-for="Description" rows="5"></textarea>
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" asp-for="IsActive" />
        <label class="form-check-label">Active</label>
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/LanguageCourses">Cancel</a>
</form>
