@model List<Victoria.Web.Models.Education.LanguageCourseListViewModel>
@{
    ViewData["Title"] = "Language Courses";
}

<h2 class="mb-3">Language Courses</h2>
@{
    var sort = (ViewBag.Sort as string) ?? "created_desc";
}

<form method="get" class="mb-3" style="max-width:320px;">
    <label class="form-label">Sort</label>
    <select class="form-select" name="sort" onchange="this.form.submit()">
        <option value="created_desc" selected="@(sort == "created_desc")">Created: newest</option>
        <option value="created_asc" selected="@(sort == "created_asc")">Created: oldest</option>

    </select>
</form>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" href="/LanguageCourses/Create">+ Add course</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Language</th>
            <th>Level</th>
            <th>Price</th>
            <th>Currency</th>
            <th>Active</th>
            <th style="width:160px;"></th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center">No courses.</td>
            </tr>
        }
        else
        {
            foreach (var x in Model)
            {
                <tr>
                    <td>@x.Id</td>
                    <td>@x.Name</td>
                    <td>@(x.Language ?? "-")</td>
                    <td>@(x.Level ?? "-")</td>
                    <td>@x.Price.ToString("0.00")</td>
                    <td>@x.Currency</td>
                    <td>
                        @if (x.IsActive)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/LanguageCourses/Details/@x.Id">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
