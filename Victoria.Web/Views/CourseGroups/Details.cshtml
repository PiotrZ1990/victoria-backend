@model Victoria.Web.Models.Education.CourseGroupDetailsViewModel
@{
    ViewData["Title"] = "Course Group Details";
}

<h2 class="mb-3">Course Group Details</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>Course:</strong> @Model.CourseName</p>
        <p><strong>Group name:</strong> @(Model.GroupName ?? "-")</p>
        <p><strong>Dates:</strong> @Model.StartDate.ToString("yyyy-MM-dd") - @Model.EndDate.ToString("yyyy-MM-dd")</p>
        <p><strong>Capacity:</strong> @Model.Capacity</p>
        <p><strong>Location:</strong> @(Model.Location ?? "-")</p>
        <p><strong>Active:</strong> @(Model.IsActive ? "Yes" : "No")</p>
        <p><strong>Created:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>

        <hr />
        <a class="btn btn-secondary" href="/CourseGroups">← Back</a>
        <a class="btn btn-warning ms-2" href="/CourseGroups/Edit/@Model.Id">Edit</a>

        <form method="post" action="/CourseGroups/Delete/@Model.Id" style="display:inline;">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger ms-2" onclick="return confirm('Delete?');">Delete</button>
        </form>
    </div>
</div>
