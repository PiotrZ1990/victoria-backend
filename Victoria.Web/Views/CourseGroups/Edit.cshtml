@model Victoria.Web.Models.Education.CourseGroupEditViewModel
@{
    ViewData["Title"] = "Edit Course Group";
}

<h2 class="mb-3">Edit Course Group</h2>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">LanguageCourseId</label>
        <input class="form-control" asp-for="LanguageCourseId" />
    </div>

    <div class="mb-3">
        <label class="form-label">Group name</label>
        <input class="form-control" asp-for="GroupName" />
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">StartDate</label>
            <input class="form-control" type="date" asp-for="StartDate" />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">EndDate</label>
            <input class="form-control" type="date" asp-for="EndDate" />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Capacity</label>
            <input class="form-control" asp-for="Capacity" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Location</label>
        <input class="form-control" asp-for="Location" />
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" asp-for="IsActive" />
        <label class="form-check-label">Active</label>
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/CourseGroups/Details/@Model.Id">Cancel</a>
</form>
