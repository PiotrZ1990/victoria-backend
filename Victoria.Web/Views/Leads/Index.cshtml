@model List<Victoria.Web.Models.Crm.LeadViewModel>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


@{
    ViewData["Title"] = "Leads (CRM)";
}

<h2 class="mb-3">Leads (CRM)</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        + Add new lead
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Full name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Country</th>
            <th>Service</th>
            <th>Status</th>
            <th>Created</th>
            <th style="width: 200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="9" class="text-center">
                    No leads found.
                </td>
            </tr>
        }
        else
        {
            foreach (var lead in Model)
            {
                <tr>
                    <td>@lead.Id</td>
                    <td>@lead.FullName</td>
                    <td>@lead.Email</td>
                    <td>@lead.PhoneNumber</td>
                    <td>@lead.InterestedCountry</td>
                    <td>@lead.InterestedService</td>
                    <td>
                        <span class="badge bg-secondary">
                            @lead.Status
                        </span>
                    </td>
                    <td>@lead.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@lead.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        @if (lead.Status != "Converted")
                        {
                            <form asp-action="ConvertToCaseFile"
                                  asp-route-id="@lead.Id"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-success"
                                        onclick="return confirm('Convert this lead to Case File?');">
                                    Convert
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
