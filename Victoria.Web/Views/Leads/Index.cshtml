@model List<Victoria.Web.Models.Crm.LeadViewModel>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


@{
    ViewData["Title"] = "Leads (CRM)";
}

<h2 class="mb-3">Leads (CRM)</h2>
@{
    var sort = (ViewBag.Sort as string) ?? "created_desc";
}

<form method="get" class="mb-3" style="max-width:320px;">
    <label class="form-label">Sort</label>
    <select class="form-select" name="sort" onchange="this.form.submit()">
        <option value="created_desc" selected="@(sort == "created_desc")">Created: newest</option>
        <option value="created_asc" selected="@(sort == "created_asc")">Created: oldest</option>

        <option value="id_desc" selected="@(sort == "id_desc")">ID: desc</option>
        <option value="id_asc" selected="@(sort == "id_asc")">ID: asc</option>

        <option value="name_asc" selected="@(sort == "name_asc")">Name: A-Z</option>
        <option value="name_desc" selected="@(sort == "name_desc")">Name: Z-A</option>

        <option value="status_asc" selected="@(sort == "status_asc")">Status: A-Z</option>
        <option value="status_desc" selected="@(sort == "status_desc")">Status: Z-A</option>

        <option value="country_asc" selected="@(sort == "country_asc")">Country: A-Z</option>
        <option value="country_desc" selected="@(sort == "country_desc")">Country: Z-A</option>
    </select>
</form>


<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        + Add new lead
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Full name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Country</th>
            <th>Service</th>
            <th>Status</th>
            <th>Created</th>
            <th style="width: 200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="9" class="text-center">
                    No leads found.
                </td>
            </tr>
        }
        else
        {
            foreach (var lead in Model)
            {
                <tr>
                    <td>@lead.Id</td>
                    <td>@lead.FullName</td>
                    <td>@lead.Email</td>
                    <td>@lead.PhoneNumber</td>
                    <td>@lead.InterestedCountry</td>
                    <td>@lead.InterestedService</td>
                    <td>
                        <span class="badge bg-secondary">
                            @lead.Status
                        </span>
                    </td>
                    <td>@lead.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@lead.Id"
                           class="btn btn-sm btn-primary me-1">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@lead.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        @if (lead.Status != "Converted")
                        {
                            <form asp-action="ConvertToCaseFile"
                                  asp-route-id="@lead.Id"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-success"
                                        onclick="return confirm('Convert this lead to Case File?');">
                                    Convert
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
