@model List<Victoria.Web.Models.Crm.LeadViewModel>

@{
    ViewData["Title"] = "Leads";
}

<h2>Leads</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Country</th>
            <th>Service</th>
            <th>Status</th>
            <th>Created</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lead in Model)
        {
            <tr>
                <td>@lead.FullName</td>
                <td>@lead.Email</td>
                <td>@lead.InterestedCountry</td>
                <td>@lead.InterestedService</td>
                <td>@lead.Status</td>
                <td>@lead.CreatedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>
