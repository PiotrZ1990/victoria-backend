@model List<NewsPostListViewModel>

<h2>News (CMS)</h2>

<a asp-action="Create" class="btn btn-primary mb-2">+ Add post</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Published</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Title</td>
                <td>@(x.IsPublished ? "Yes" : "No")</td>
                <td>@x.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/NewsPosts/Details/@x.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
