@model NewsPostDetailsViewModel
@{
    ViewData["Title"] = "News Post Details";
}

<h2>News Post Details</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>Title:</strong> @Model.Title</p>
        <p>
            <strong>Status:</strong>
            @if (Model.IsPublished)
            {
                <span class="badge bg-success">Published</span>
            }
            else
            {
                <span class="badge bg-secondary">Draft</span>
            }
        </p>
        <p><strong>Created:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>

        <hr />
        <h5>Content</h5>
        <div style="white-space: pre-wrap;">@Model.Content</div>

        <hr />

        <a class="btn btn-secondary" asp-action="Index">← Back</a>
        <a class="btn btn-warning ms-2" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger ms-2"
                    onclick="return confirm('Delete this post?');">
                Delete
            </button>
        </form>
    </div>
</div>
