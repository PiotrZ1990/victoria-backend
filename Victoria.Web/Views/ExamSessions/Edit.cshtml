@model Victoria.Web.Models.Education.ExamSessionEditViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit Exam Session";
}

<h2 class="mb-3">Edit Exam Session</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Exam</label>
        <select class="form-select" asp-for="ExamId" asp-items="(SelectList)ViewBag.Exams"></select>
        <span class="text-danger" asp-validation-for="ExamId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Session date</label>
        <input class="form-control" type="date" asp-for="SessionDate" />
        <span class="text-danger" asp-validation-for="SessionDate"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Location</label>
        <input class="form-control" asp-for="Location" />
        <span class="text-danger" asp-validation-for="Location"></span>
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/ExamSessions/Details/@Model.Id">Cancel</a>
</form>
