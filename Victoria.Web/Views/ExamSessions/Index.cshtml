@model List<Victoria.Web.Models.Education.ExamSessionListViewModel>
@{
    ViewData["Title"] = "Exam Sessions";
}

<h2 class="mb-3">Exam Sessions</h2>
@{
    var sort = (ViewBag.Sort as string) ?? "created_desc";
}

<form method="get" class="mb-3" style="max-width:320px;">
    <label class="form-label">Sort</label>
    <select class="form-select" name="sort" onchange="this.form.submit()">
        <option value="created_desc" selected="@(sort == "created_desc")">Created: newest</option>
        <option value="created_asc" selected="@(sort == "created_asc")">Created: oldest</option>

    </select>
</form>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-success" href="/ExamSessions/Create">+ Create session</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Exam</th>
            <th>Date</th>
            <th>Location</th>
            <th>Capacity</th>
            <th>Active</th>
            <th style="width:120px;"></th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="7" class="text-center">No sessions.</td></tr>
        }
        else
        {
            foreach (var x in Model)
            {
                <tr>
                    <td>@x.Id</td>
                    <td>@x.ExamName</td>
                    <td>@x.SessionDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(x.Location ?? "-")</td>
                    <td>@x.Capacity</td>
                    <td>@(x.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/ExamSessions/Details/@x.Id">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
