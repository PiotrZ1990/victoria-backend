@model Victoria.Web.Models.Staff.EmployeeViewModel

<h2 class="mb-3">Employee Details</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>Full name:</strong> @Model.FullName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.PhoneNumber</p>
        <p><strong>Position:</strong> @Model.Position</p>
        <p><strong>Active:</strong> @(Model.IsActive ? "Yes" : "No")</p>

        <a class="btn btn-secondary" asp-action="Index">← Back</a>
        <a class="btn btn-warning ms-2" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger ms-2"
                    onclick="return confirm('Delete this employee?');">
                Delete
            </button>
        </form>
    </div>
</div>
