@model List<Victoria.Web.Models.Cms.SettingListViewModel>
@{
    ViewData["Title"] = "Settings";
}

<h2 class="mb-3">Settings</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" href="/Settings/Create">+ Add setting</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Key</th>
            <th>Value</th>
            <th>Updated</th>
            <th style="width:120px;"></th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="4" class="text-center">No settings.</td></tr>
        }
        else
        {
            foreach (var x in Model)
            {
                <tr>
                    <td>@x.Key</td>
                    <td>@(string.IsNullOrWhiteSpace(x.Value) ? "-" : x.Value)</td>
                    <td>@x.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/Settings/Details/@x.Id">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
