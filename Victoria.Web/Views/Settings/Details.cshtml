@model Victoria.Web.Models.Cms.SettingDetailsViewModel
@{
    ViewData["Title"] = "Setting Details";
}

<h2 class="mb-3">Setting Details</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>Key:</strong> @Model.Key</p>
        <p><strong>Value:</strong> @(string.IsNullOrWhiteSpace(Model.Value) ? "-" : Model.Value)</p>
        <p><strong>Updated:</strong> @Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</p>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <hr />
            <p><strong>Description:</strong><br />@Model.Description</p>
        }

        <hr />
        <a class="btn btn-secondary" href="/Settings">← Back</a>
        <a class="btn btn-warning ms-2" href="/Settings/Edit/@Model.Id">Edit</a>

        <form method="post" action="/Settings/Delete/@Model.Id" style="display:inline;">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger ms-2" onclick="return confirm('Delete this setting?');">Delete</button>
        </form>
    </div>
</div>
