@model Victoria.Web.Models.Cms.SettingCreateViewModel
@{
    ViewData["Title"] = "Create Setting";
}

<h2 class="mb-3">Create Setting</h2>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Key</label>
        <input class="form-control" asp-for="Key" />
        <span class="text-danger" asp-validation-for="Key"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Value</label>
        <input class="form-control" asp-for="Value" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" asp-for="Description" rows="4"></textarea>
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/Settings">Cancel</a>
</form>
