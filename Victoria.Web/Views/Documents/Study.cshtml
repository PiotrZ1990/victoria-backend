@model List<Victoria.Web.Models.Documents.DocumentListViewModel>

<h2>Study Application Documents</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Type</th>
            <th>Status</th>
            <th>File</th>
            <th>Created</th>
            <th style="width:220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.Id</td>
                <td>@d.DocumentType</td>
                <td>@d.Status</td>
                <td>@d.File.FileName</td>
                <td>@d.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <form method="post" asp-action="Approve" asp-route-id="@d.Id" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-success">Approve</button>
                    </form>

                    <form method="post" asp-action="Reject" asp-route-id="@d.Id" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reason" value="Rejected from list" />
                        <button class="btn btn-sm btn-danger">Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
