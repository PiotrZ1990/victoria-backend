@model List<Victoria.Web.Models.Documents.DocumentListViewModel>

@{
    ViewData["Title"] = "Visa Documents";
    var visaApplicationId = (int)ViewBag.VisaApplicationId;
}

<h2 class="mb-3">Visa Documents</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-success" href="/Documents/UploadVisa?visaApplicationId=@visaApplicationId">
        + Upload document
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <p>No documents.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Type</th>
                <th>Status</th>
                <th>File</th>
                <th>Created</th>
                <th style="width:260px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Id</td>
                    <td>@d.DocumentType</td>
                    <td>@d.Status</td>
                    <td>@d.Description</td>
                    <td>@d.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/Documents/Details/@d.Id">Details</a>

                        <form asp-action="Approve" asp-route-id="@d.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-success"
                                    onclick="return confirm('Approve this document?');">
                                Approve
                            </button>
                        </form>

                        <form asp-action="Reject" asp-route-id="@d.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reason" value="Rejected from Visa list" />
                            <button class="btn btn-sm btn-danger"
                                    onclick="return confirm('Reject this document?');">
                                Reject
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
