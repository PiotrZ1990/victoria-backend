@model List<Victoria.Web.Models.Documents.DocumentListViewModel>

@{
    ViewData["Title"] = "Documents";
}

<h2 class="mb-3">Documents</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" href="/Documents/Upload">+ Upload document</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Type</th>
            <th>Status</th>
            <th>Created</th>
            <th style="width:140px;"></th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="5" class="text-center">No documents.</td></tr>
        }
        else
        {
            foreach (var d in Model)
            {
                <tr>
                    <td>@d.Id</td>
                    <td>@d.DocumentType</td>
                    <td>@d.Status</td>
                    <td>@d.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/Documents/Details/@d.Id">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
