@model Victoria.Web.Models.Documents.DocumentUploadVisaViewModel

@{
    ViewData["Title"] = "Upload Visa Document";
}

<h2 class="mb-3">Upload Visa Document</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="UploadVisa" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="VisaApplicationId" />

    <div class="mb-3">
        <label class="form-label">Title (DocumentType)</label>
        <input class="form-control" asp-for="Title" />
        <span class="text-danger" asp-validation-for="Title"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Description (optional)</label>
        <input class="form-control" asp-for="Description" />
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">File</label>
        <input class="form-control" asp-for="File" type="file" />
        <span class="text-danger" asp-validation-for="File"></span>
    </div>

    <button class="btn btn-success" type="submit">Upload</button>
    <a class="btn btn-secondary" href="/Documents/Visa?visaApplicationId=@Model.VisaApplicationId">Cancel</a>
</form>
