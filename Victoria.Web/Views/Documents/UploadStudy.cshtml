@model Victoria.Web.Models.Documents.DocumentUploadStudyViewModel
@{
    ViewData["Title"] = "Upload document (Study Application)";
}

<h2 class="mb-3">Upload document (Study Application)</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="UploadStudy" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="StudyApplicationId" />

    <div class="mb-3">
        <label class="form-label">Document type</label>

        <select class="form-select" asp-for="Title">
            <option value="">-- select --</option>

            <option value="Passport scan">Passport scan</option>
            <option value="CV">CV</option>
            <option value="Motivation letter">Motivation letter</option>
            <option value="School certificates / diplomas">School certificates / diplomas</option>
            <option value="English test certificate (optional)">English test certificate (optional)</option>
            <option value="Proof of funds (if needed)">Proof of funds (if needed)</option>
        </select>


        <span class="text-danger" asp-validation-for="Title"></span>
        <div class="form-text">Must match checklist DocumentType exactly (ważne dla Approve/Reject).</div>
    </div>


    <div class="mb-3">
        <label class="form-label">Description (optional)</label>
        <input class="form-control" asp-for="Description" />
    </div>

    <div class="mb-3">
        <label class="form-label">File</label>
        <input class="form-control" asp-for="File" type="file" />
        <span class="text-danger" asp-validation-for="File"></span>
    </div>

    <button class="btn btn-success" type="submit">Upload</button>
</form>
