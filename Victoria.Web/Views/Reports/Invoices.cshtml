@model Victoria.Web.Models.Reports.ReportsInvoicesViewModel
@{
    ViewData["Title"] = "Reports - Invoices";
}

<h2 class="mb-3">Reports - Invoices</h2>

<div class="mb-3">
    <a class="btn btn-sm btn-success" href="/Reports/OutstandingInvoicesExcel">Outstanding (Excel)</a>
    <a class="btn btn-sm btn-danger ms-2" href="/Reports/OutstandingInvoicesPdf">Outstanding (PDF)</a>
</div>

<div class="card mb-3">
    <div class="card-header"><strong>Status summary</strong></div>
    <div class="card-body">
        @if (Model.StatusSummary == null || !Model.StatusSummary.Any())
        {
            <p>No data.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr><th>Status</th><th>Count</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.StatusSummary)
                    {
                        <tr>
                            <td>@s.Status</td>
                            <td>@s.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Overdue invoices</strong>

        <form method="get" class="d-flex gap-2">
            <input class="form-control form-control-sm" style="width:120px" type="number" name="days" value="@Model.Days" min="1" />
            <button class="btn btn-sm btn-outline-primary" type="submit">Reload</button>
        </form>
    </div>

    <div class="card-body">
        @if (Model.Overdue == null || !Model.Overdue.Any())
        {
            <p>No overdue invoices.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Case</th>
                        <th>IssueDate</th>
                        <th>Days</th>
                        <th>Remaining</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model.Overdue)
                    {
                        <tr>
                            <td>@x.InvoiceNumber</td>
                            <td>@x.CaseFileId</td>
                            <td>@x.IssueDate.ToString("yyyy-MM-dd")</td>
                            <td>@x.DaysOverdue</td>
                            <td>@x.RemainingAmount @x.Currency</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="/Invoices/Details/@x.InvoiceId">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card">
    <div class="card-header"><strong>Outstanding invoices (all)</strong></div>
    <div class="card-body">
        @if (Model.Outstanding == null || !Model.Outstanding.Any())
        {
            <p>No outstanding invoices.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Case</th>
                        <th>IssueDate</th>
                        <th>Status</th>
                        <th>Remaining</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model.Outstanding)
                    {
                        <tr>
                            <td>@x.InvoiceNumber</td>
                            <td>@x.CaseFileId</td>
                            <td>@x.IssueDate.ToString("yyyy-MM-dd")</td>
                            <td>@x.Status</td>
                            <td>@x.RemainingAmount @x.Currency</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="/Invoices/Details/@x.InvoiceId">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
