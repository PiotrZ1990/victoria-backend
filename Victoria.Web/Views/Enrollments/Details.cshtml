@model Victoria.Web.Models.Education.EnrollmentDetailsViewModel
@{
    ViewData["Title"] = "Enrollment Details";
}

<h2 class="mb-3">Enrollment Details</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>

        <p><strong>Student:</strong> @Model.StudentName (Id: @Model.StudentId)</p>
        <p><strong>Group:</strong> @(Model.GroupName ?? "-") (Id: @Model.CourseGroupId)</p>
        <p><strong>Course:</strong> @Model.CourseName</p>

        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>EnrolledAt:</strong> @Model.EnrolledAt.ToString("yyyy-MM-dd HH:mm")</p>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <hr />
            <p><strong>Notes:</strong> @Model.Notes</p>
        }

        <hr />
        <a class="btn btn-secondary" href="/Enrollments">← Back</a>
        <a class="btn btn-warning ms-2" href="/Enrollments/Edit/@Model.Id">Edit</a>

        <form method="post" action="/Enrollments/Delete/@Model.Id" style="display:inline;">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger ms-2" onclick="return confirm('Delete?');">Delete</button>
        </form>
    </div>
</div>
