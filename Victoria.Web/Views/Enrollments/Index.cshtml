@model List<Victoria.Web.Models.Education.EnrollmentListViewModel>
@{
    ViewData["Title"] = "Enrollments";
}

<h2 class="mb-3">Enrollments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" href="/Enrollments/Create">+ Add enrollment</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Student</th>
            <th>Course</th>
            <th>Group</th>
            <th>Status</th>
            <th>Enrolled</th>
            <th style="width:150px;"></th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="7" class="text-center">No enrollments.</td></tr>
        }
        else
        {
            foreach (var x in Model)
            {
                <tr>
                    <td>@x.Id</td>
                    <td>@x.StudentName (@x.StudentId)</td>
                    <td>@x.CourseName</td>
                    <td>@(x.GroupName ?? "-") (@x.CourseGroupId)</td>
                    <td><span class="badge bg-secondary">@x.Status</span></td>
                    <td>@x.EnrolledAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/Enrollments/Details/@x.Id">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
