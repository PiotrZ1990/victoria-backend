@model Victoria.Web.Models.Cases.CaseFileDetailsViewModel
@using Victoria.Web.Models.Cases
@using Victoria.Web.Models.Payments

@{
    ViewData["Title"] = "Case Details";

    var readiness = ViewBag.Readiness as CaseReadinessViewModel;
    var stageUpdate = ViewBag.StageUpdate as CaseStageUpdateViewModel;
    var updateVm = ViewBag.UpdateVm as CaseFileUpdateViewModel;
}

<h2 class="mb-3">Case Details</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<hr />

<div class="card mb-3">
    <div class="card-header"><strong>Case</strong></div>
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>CaseNumber:</strong> @Model.CaseNumber</p>
        <p><strong>LeadId:</strong> @Model.LeadId</p>
        <p><strong>Stage:</strong> @Model.Stage</p>
        <p><strong>CreatedAt:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd")</p>

        <div class="mt-2">
            <a class="btn btn-secondary" href="/CaseFiles">← Back</a>

            <a class="btn btn-outline-primary ms-2"
               href="/StudyApplications?caseFileId=@Model.Id">
                Study Applications
            </a>

            <a class="btn btn-outline-primary ms-2"
               href="/VisaApplications?caseFileId=@Model.Id">
                Visa Applications
            </a>

            <a class="btn btn-outline-primary ms-2"
               href="/Checklists/Application?caseFileId=@Model.Id">
                Application Checklist
            </a>

            <a class="btn btn-outline-primary ms-2"
               href="/Checklists/Visa?caseFileId=@Model.Id">
                Visa Checklist
            </a>
            <a class="btn btn-outline-success ms-2"
               href="/Payments/Case?caseFileId=@Model.Id">
                Payments
            </a>

        </div>
    </div>
</div>

@if (readiness != null && stageUpdate != null)
{
    <div class="card mb-3">
        <div class="card-header"><strong>Readiness</strong></div>
        <div class="card-body">
            <p><strong>Current stage:</strong> @readiness.Stage</p>

            <div class="mb-2">
                <strong>Application required:</strong>
                @readiness.CompletedApplicationItems / @readiness.RequiredApplicationItems
                <span class="badge @(readiness.CanMoveToApplication ? "bg-success" : "bg-secondary") ms-2">
                    Can move: @readiness.CanMoveToApplication
                </span>
            </div>

            <div class="mb-2">
                <strong>Visa required:</strong>
                @readiness.CompletedVisaItems / @readiness.RequiredVisaItems
                <span class="badge @(readiness.CanMoveToVisa ? "bg-success" : "bg-secondary") ms-2">
                    Can move: @readiness.CanMoveToVisa
                </span>
            </div>

            <form asp-action="ChangeStage" method="post" class="row g-2 mt-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CaseFileId" value="@stageUpdate.CaseFileId" />

                <div class="col-md-4">
                    <label class="form-label">Change stage</label>
                    <select class="form-select" name="Stage">
                        <option value="New">New</option>
                        <option value="Planning">Planning</option>
                        <option value="Application">Application</option>
                        <option value="Visa">Visa</option>
                        <option value="Accommodation">Accommodation</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-primary" type="submit">Update stage</button>
                </div>
            </form>
        </div>
    </div>
}

@if (updateVm != null)
{
    <div class="card mb-3">
        <div class="card-header"><strong>Update notes</strong></div>
        <div class="card-body">
            <form asp-action="Update" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="Id" value="@updateVm.Id" />
                <input type="hidden" name="Stage" value="@Model.Stage" />

                <div class="mb-3">
                    <label class="form-label">Internal notes</label>
                    <textarea class="form-control" name="InternalNotes" rows="4">@updateVm.InternalNotes</textarea>
                </div>

                <button class="btn btn-success" type="submit">Save</button>
            </form>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Invoices</strong>

        <a class="btn btn-sm btn-success"
           href="/Invoices/Create?caseFileId=@Model.Id">
            + Create invoice
        </a>
    </div>

    <div class="card-body">
        @if (Model.Invoices == null || !Model.Invoices.Any())
        {
            <p>No invoices.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Issue</th>
                        <th>Total</th>
                        <th>Currency</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.Invoices)
                    {
                        <tr>
                            <td>@inv.InvoiceNumber</td>
                            <td>@inv.IssueDate.ToString("yyyy-MM-dd")</td>
                            <td>@inv.TotalAmount</td>
                            <td>@inv.Currency</td>
                            <td>@inv.Status</td>
                            <td>
                                <a class="btn btn-sm btn-primary" href="/Invoices/Details/@inv.Id">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
