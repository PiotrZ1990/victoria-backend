@model Victoria.Web.Models.Cases.CaseFileDetailsViewModel

@{
    ViewData["Title"] = "Case File Details";
}

<h2 class="mb-3">Case File Details</h2>

<div class="mb-4">
    <a asp-action="Index" class="btn btn-secondary">← Back to list</a>
</div>

<div class="card mb-4">
    <div class="card-header">
        <strong>Case</strong>
    </div>
    <div class="card-body">
        <p><strong>Case Number:</strong> @Model.CaseNumber</p>
        <p><strong>Stage:</strong> @Model.Stage</p>
        <p><strong>Created:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
        <p><strong>Internal Notes:</strong> @(string.IsNullOrWhiteSpace(Model.InternalNotes) ? "-" : Model.InternalNotes)</p>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <strong>Update Case (Stage + Notes)</strong>
    </div>
    <div class="card-body">
        <form asp-controller="CaseFiles" asp-action="Update" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label">Stage</label>
                <select class="form-select" name="Stage">
                    <option value="New" selected="@(Model.Stage == "New")">New</option>
                    <option value="Planning" selected="@(Model.Stage == "Planning")">Planning</option>
                    <option value="Application" selected="@(Model.Stage == "Application")">Application</option>
                    <option value="Visa" selected="@(Model.Stage == "Visa")">Visa</option>
                    <option value="Accommodation" selected="@(Model.Stage == "Accommodation")">Accommodation</option>
                    <option value="Completed" selected="@(Model.Stage == "Completed")">Completed</option>
                    <option value="Cancelled" selected="@(Model.Stage == "Cancelled")">Cancelled</option>
                </select>

            </div>

            <div class="mb-3">
                <label class="form-label">Internal Notes</label>
                <textarea class="form-control" name="InternalNotes" rows="4">@Model.InternalNotes</textarea>
            </div>

            <button class="btn btn-primary" type="submit">Save</button>
        </form>
    </div>
</div>


<div class="card">
    <div class="card-header">
        <strong>Client (Lead)</strong>
    </div>
    <div class="card-body">
        <p><strong>Name:</strong> @Model.LeadFullName</p>
        <p><strong>Email:</strong> @Model.LeadEmail</p>
        <p><strong>Phone:</strong> @Model.LeadPhoneNumber</p>
        <p><strong>Source:</strong> @Model.LeadSource</p>
        <p><strong>Interested Country:</strong> @Model.LeadInterestedCountry</p>
        <p><strong>Interested Service:</strong> @Model.LeadInterestedService</p>
        <p><strong>Lead Status:</strong> @Model.LeadStatus</p>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <strong>Invoices</strong>
    </div>
    <div class="card-body">
        @if (Model.Invoices == null || !Model.Invoices.Any())
        {
            <p>No invoices for this case.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Issue date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.Invoices)
                    {
                        <tr>
                            <td>@inv.InvoiceNumber</td>
                            <td>@inv.IssueDate.ToString("yyyy-MM-dd")</td>
                            <td>@inv.TotalAmount @inv.Currency</td>
                            <td>
                                <span class="badge bg-secondary">@inv.Status</span>
                            </td>
                            <td>
                                @* Następny krok: szczegóły faktury + płatności *@
                                <a class="btn btn-sm btn-primary"
                                   href="/Invoices/Details/@inv.Id">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

