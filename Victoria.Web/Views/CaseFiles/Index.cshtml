@model List<Victoria.Web.Models.Cases.CaseFileViewModel>

@{
    ViewData["Title"] = "Case Files";
}

<h2 class="mb-3">Case Files</h2>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Id</th>
            <th>Case #</th>
            <th>LeadId</th>
            <th>Stage</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.CaseNumber</td>
                <td>@c.LeadId</td>
                <td>@c.Stage</td>
                <td>@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/CaseFiles/Details/@c.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
