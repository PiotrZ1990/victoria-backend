@model List<Victoria.Web.Models.Cases.CaseFileViewModel>

@{
    ViewData["Title"] = "Case Files";
}

<h2 class="mb-3">Case Files</h2>

@{
    var sort = (ViewBag.Sort as string) ?? "created_desc";
}

<form method="get" class="mb-3" style="max-width:320px;">
    <label class="form-label">Sort</label>
    <select class="form-select" name="sort" onchange="this.form.submit()">
        <option value="created_desc" selected="@(sort == "created_desc")">Created: newest</option>
        <option value="created_asc" selected="@(sort == "created_asc")">Created: oldest</option>
        <option value="id_desc" selected="@(sort == "id_desc")">Id: desc</option>
        <option value="id_asc" selected="@(sort == "id_asc")">Id: asc</option>
        <option value="stage_asc" selected="@(sort == "stage_asc")">Stage: A-Z</option>
        <option value="stage_desc" selected="@(sort == "stage_desc")">Stage: Z-A</option>
    </select>
</form>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Id</th>
            <th>Case #</th>
            <th>LeadId</th>
            <th>Stage</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.CaseNumber</td>
                <td>@c.LeadId</td>
                <td>@c.Stage</td>
                <td>@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/CaseFiles/Details/@c.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
